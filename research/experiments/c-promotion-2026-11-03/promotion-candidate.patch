 // --- Move Generation & Execution ---
 
+/* EXPERIMENTAL: four FIDE promotion choices, encoded as special=3..6. */
+static uint8_t append_promotion_options(Move *moves, uint8_t index) {
+    Move original = moves[index];
+    uint8_t count = (uint8_t)(index + 1);
+    if (original.special == 3) {
+        for (uint8_t promotion = 4; promotion <= 6; promotion++) {
+            if (count == MAX_MOVES) return count;
+            moves[count] = original;
+            moves[count].special = promotion;
+            count++;
+        }
+    }
+    return count;
+}
